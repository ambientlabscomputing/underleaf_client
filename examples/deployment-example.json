{
  "id": "deploy-001",
  "org_id": "org-123",
  "name": "My Web Application",
  "slug": "mywebapp",
  "version": 1,
  "networks": [
    {
      "name": "app_network",
      "driver": "bridge"
    }
  ],
  "volumes": [
    {
      "name": "db_data"
    }
  ],
  "services": [
    {
      "name": "database",
      "image": "postgres:15-alpine",
      "environment": {
        "POSTGRES_PASSWORD": "mysecretpassword",
        "POSTGRES_DB": "myapp"
      },
      "volumes": [
        "db_data:/var/lib/postgresql/data"
      ],
      "networks": [
        "app_network"
      ]
    },
    {
      "name": "api",
      "image": "myorg/myapp-api:latest",
      "environment": {
        "DATABASE_URL": "postgresql://postgres:mysecretpassword@mywebapp_database:5432/myapp",
        "PORT": "8080"
      },
      "networks": [
        "app_network"
      ],
      "depends_on": [
        "database"
      ]
    },
    {
      "name": "web",
      "image": "nginx:alpine",
      "ports": [
        "80:80"
      ],
      "networks": [
        "app_network"
      ],
      "depends_on": [
        "api"
      ]
    }
  ],
  "targeting": {
    "mode": "all"
  }
}
